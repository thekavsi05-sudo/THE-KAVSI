# Base URL of the Express API (see /server)
VITE_API_BASE_URL=http://localhost:5000/api

# Google Maps JavaScript API key (Maps JavaScript API + Geocoding API enabled)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# WhatsApp number in international format, no + or spaces
VITE_WHATSAPP_NUMBER=919490777920

# No Razorpay key needed here — the backend's /api/payments/razorpay/order
# response includes the public key_id, which is safe to use client-side.
